<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  body { margin:0; background:#FAF9FB; -webkit-font-smoothing:antialiased; }
  body *, body *::before, body *::after { box-sizing:border-box; }
  a { color:#7C5CD6; text-decoration:none; }
  a:hover { color:#5B3FA8; }
  @keyframes nayaRise { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:none; } }
  @keyframes nayaPop { from { opacity:0; transform:translate(-50%,-100%) scale(0.92); } to { opacity:1; transform:translate(-50%,-100%) scale(1); } }
  @keyframes nayaSweep { 0% { transform:translateX(-60%); } 100% { transform:translateX(60%); } }
  @media (prefers-reduced-motion: reduce) {
    @keyframes nayaRise { from { opacity:1; transform:none; } to { opacity:1; transform:none; } }
    @keyframes nayaSweep { 0% { opacity:0; } 100% { opacity:0; } }
  }
</style>
</helmet>

<div style="font-family:'Jost',system-ui,sans-serif; color:#1C1A22; background:#FAF9FB; min-height:100vh; padding-bottom:96px;">

  <header style="display:flex; align-items:center; justify-content:space-between; gap:24px; padding:22px clamp(20px,5vw,64px); border-bottom:1px solid #ECE8F2; background:rgba(250,249,251,0.9); backdrop-filter:blur(8px); position:sticky; top:0; z-index:10;">
    <div style="display:flex; align-items:center; gap:13px; color:#1C1A22;" aria-label="Naya Lumière Cosmetics">
      <div style="flex:none; width:34px; aspect-ratio:405/352; -webkit-mask:url(uploads/lotus-mask.png) center/contain no-repeat; mask:url(uploads/lotus-mask.png) center/contain no-repeat; background:currentColor;"></div>
      <img src="uploads/wordmark.png" alt="Naya Lumière Cosmetics" style="height:26px; width:auto; display:block;">
    </div>
    <nav style="display:flex; gap:clamp(14px,2.4vw,34px); align-items:center; font-size:12px; letter-spacing:0.14em; text-transform:uppercase; color:#6E6879;">
      <a href="#shop" style="color:#6E6879;">Shop</a>
      <a href="#rituals" style="color:#6E6879;">Rituals</a>
      <a href="#tiers" style="color:#1C1A22; border-bottom:1px solid #C4A9F5; padding-bottom:3px;">Loyalty</a>
      <span style="width:34px; height:34px; border-radius:50%; background:#EFE9FB; color:#6D4FC4; display:flex; align-items:center; justify-content:center; font-size:12px; letter-spacing:0.06em;">AR</span>
    </nav>
  </header>

  <div style="max-width:1160px; margin:0 auto; padding:0 clamp(20px,5vw,40px);">

    <section style="padding:clamp(48px,7vw,88px) 0 clamp(28px,4vw,44px); display:grid; gap:14px; max-width:640px;">
      <span style="font-size:11px; letter-spacing:0.28em; text-transform:uppercase; color:#9B93A8;">The Lumière Circle</span>
      <h1 style="font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(38px,5.4vw,60px); line-height:1.06; margin:0; letter-spacing:-0.01em;">Good morning, Amélie.</h1>
      <p style="margin:0; font-weight:300; font-size:17px; line-height:1.65; color:#6E6879; text-wrap:pretty;">Your membership deepens with every ritual — quiet rewards, earlier access, and care shaped around your skin.</p>
    </section>

    <section style="display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:clamp(24px,3.4vw,44px); align-items:center; padding-bottom:clamp(40px,5vw,64px);">

      <div tabindex="0" role="button" aria-label="{{ heroAria }}" style="position:relative; perspective:1400px; border-radius:24px; outline:none; transition:transform 0.35s cubic-bezier(0.2,0.8,0.2,1);" style-hover="transform:translateY(-5px)" style-focus="outline:2px solid #7C5CD6; outline-offset:8px" onClick="{{ toggleMine }}" onKeyDown="{{ keyMine }}" onMouseMove="{{ moveMine }}" onMouseLeave="{{ leaveMine }}">
        <div style="position:absolute; left:9%; right:9%; bottom:-3%; height:16%; border-radius:50%; background:{{ heroShadow }}; filter:blur(12px);"></div>
        <sc-if value="{{ upgraded }}" hint-placeholder-val="{{ false }}">
          <div style="position:absolute; left:50%; top:-12px; z-index:4; display:flex; align-items:center; gap:9px; background:#1C1A22; color:#FAF9FB; padding:10px 18px; border-radius:999px; font-size:10px; letter-spacing:0.22em; text-transform:uppercase; white-space:nowrap; box-shadow:0 14px 30px -16px rgba(28,26,34,0.65); animation:nayaPop 0.5s cubic-bezier(0.2,0.9,0.2,1) both;">
            <span style="width:6px; height:6px; border-radius:50%; background:#C4A9F5;"></span>{{ upgradeText }}
          </div>
        </sc-if>
        <div style="position:relative; width:100%; aspect-ratio:1.586; transform-style:preserve-3d; transition:transform 0.5s cubic-bezier(0.2,0.8,0.2,1); transform:translateZ(0.01px)" ref="{{ refmine }}">

          <div style="position:absolute; inset:0; backface-visibility:hidden; transform:translateZ(1.5px); border-radius:20px; overflow:hidden; background:{{ heroBg }}; box-shadow:0 0 0 1px rgba(120,105,150,0.28), 0 1px 2px rgba(40,30,60,0.3), 0 24px 46px -26px rgba(40,30,60,0.6), inset 0 1px 0 rgba(255,255,255,0.6), inset 0 -1px 0 rgba(0,0,0,0.18), inset 0 0 0 1px rgba(255,255,255,0.34); color:{{ heroInk }}; transition:background 0.8s ease, color 0.8s ease;">
            <div style="position:absolute; inset:0; background:{{ heroTexture }};"></div>
            <div style="position:absolute; inset:-20% -40%; background:{{ heroSheen }}; transform:translateX({{ shMine }}); transition:transform 0.4s ease-out;"></div>
            <div style="position:absolute; right:0; top:0; bottom:0; width:7px; background:{{ heroEdge }}; box-shadow:inset 1px 0 0 rgba(255,255,255,0.5);"></div>
            <sc-if value="{{ upgraded }}" hint-placeholder-val="{{ false }}">
              <div style="position:absolute; inset:-25% -60%; background:linear-gradient(112deg,rgba(255,255,255,0) 43%,rgba(255,255,255,0.9) 50%,rgba(255,255,255,0) 57%); animation:nayaSweep 1.5s ease-in-out 2 both;"></div>
            </sc-if>

            <div style="position:absolute; right:-12%; bottom:-24%; width:52%; aspect-ratio:405/352; opacity:0.1; -webkit-mask:url(uploads/lotus-mask.png) center/contain no-repeat; mask:url(uploads/lotus-mask.png) center/contain no-repeat; background:currentColor; pointer-events:none;"></div>
            <div style="position:absolute; inset:0; background:linear-gradient(200deg,rgba(255,255,255,0.22) 0 16%,rgba(255,255,255,0) 17% 62%,rgba(255,255,255,0.1) 100%);"></div>
            <div style="position:absolute; inset:0; background:radial-gradient(13% 20% at {{ spMine }},rgba(255,255,255,0.6),rgba(255,255,255,0) 70%), radial-gradient(46% 66% at {{ spMine }},rgba(255,255,255,0.34),rgba(255,255,255,0) 74%); transition:background 0.25s ease-out;"></div>
            <div style="position:absolute; inset:0; background-image:url(data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22180%22%20height%3D%22180%22%3E%3Cfilter%20id%3D%22n%22%20x%3D%220%22%20y%3D%220%22%3E%3CfeTurbulence%20type%3D%22fractalNoise%22%20baseFrequency%3D%220.82%22%20numOctaves%3D%224%22%20stitchTiles%3D%22stitch%22%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D%22180%22%20height%3D%22180%22%20filter%3D%22url%28%23n%29%22%2F%3E%3C%2Fsvg%3E); background-size:170px 170px; opacity:0.34; mix-blend-mode:soft-light; pointer-events:none;"></div>
                <div style="position:absolute; inset:10px; border:1px solid {{ heroInkFaint }}; border-radius:14px;"></div>
            <div style="position:absolute; left:8px; bottom:24px; transform-origin:left bottom; transform:rotate(-90deg); font-size:5px; letter-spacing:0.32em; white-space:nowrap; color:{{ heroInk }}; opacity:0.38; user-select:none;">NAYALUMIÈRECOSMETICS·NAYALUMIÈRECOSMETICS·NAYALUMIÈRE</div>
            <div style="position:absolute; left:0; right:0; bottom:0; height:5px; background:linear-gradient(180deg,rgba(255,255,255,0) 0%,rgba(255,255,255,0.4) 100%);"></div>
            <div style="position:relative; height:100%; padding:clamp(20px,2.8vw,28px); display:flex; flex-direction:column; justify-content:space-between;">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px;">
                <div style="display:flex; align-items:center; gap:13px;">
                  <div style="flex:none; width:clamp(27px,3.4vw,35px); aspect-ratio:405/352; -webkit-mask:url(uploads/lotus-mask.png) center/contain no-repeat; mask:url(uploads/lotus-mask.png) center/contain no-repeat; background:currentColor; opacity:0.95;"></div>
                  <div style="display:grid; gap:6px;">
                    <span style="font-family:'Cormorant Garamond',serif; font-size:clamp(17px,2.2vw,21px); letter-spacing:0.22em; font-weight:400;">NAYA LUMIÈRE</span>
                    <span style="font-size:8.5px; letter-spacing:0.44em; color:{{ heroInkSoft }};">COSMETICS</span>
                  </div>
                </div>
                <div style="display:grid; gap:6px; justify-items:end; padding-right:6px;">
                  <span style="font-size:9.5px; letter-spacing:0.3em; text-transform:uppercase; padding:6px 12px; border:1px solid {{ heroInkFaint }}; border-radius:999px;">{{ heroTier }}</span>
                  <span style="font-size:8px; letter-spacing:0.24em; color:{{ heroInkSoft }};">{{ heroThru }}</span>
                </div>
              </div>

              <div style="display:flex; align-items:center; gap:14px;">
                <div style="width:clamp(38px,4.4vw,46px); aspect-ratio:1.32; border-radius:6px; background:{{ heroChip }}; box-shadow:inset 0 0 0 1px rgba(255,255,255,0.5), 0 1px 2px rgba(30,22,10,0.28); display:grid; grid-template-columns:1fr 1fr; grid-template-rows:repeat(3,1fr);">
                  <div style="border-right:1px solid rgba(40,32,20,0.32); border-bottom:1px solid rgba(40,32,20,0.32);"></div>
                  <div style="border-bottom:1px solid rgba(40,32,20,0.32);"></div>
                  <div style="border-right:1px solid rgba(40,32,20,0.32); border-bottom:1px solid rgba(40,32,20,0.32);"></div>
                  <div style="border-bottom:1px solid rgba(40,32,20,0.32);"></div>
                  <div style="border-right:1px solid rgba(40,32,20,0.32);"></div>
                  <div></div>
                </div>
                <div style="position:relative; width:22px; height:22px; opacity:0.5;">
                  <span style="position:absolute; left:0; top:6px; width:9px; height:9px; border:1.4px solid currentColor; border-radius:50%; clip-path:inset(0 0 0 55%);"></span>
                  <span style="position:absolute; left:0; top:2px; width:17px; height:17px; border:1.4px solid currentColor; border-radius:50%; clip-path:inset(0 0 0 62%);"></span>
                  <span style="position:absolute; left:0; top:-2px; width:25px; height:25px; border:1.4px solid currentColor; border-radius:50%; clip-path:inset(0 0 0 68%);"></span>
                </div>
                <div style="margin-left:auto; margin-right:6px; width:clamp(28px,3.4vw,34px); aspect-ratio:1; border-radius:50%; background:{{ heroHolo }}; opacity:0.72; box-shadow:inset 0 0 0 1px rgba(255,255,255,0.6), inset 0 -2px 4px rgba(0,0,0,0.12); transform:rotate({{ hrMine }}); transition:transform 0.35s ease-out;"></div>
              </div>

              <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:20px;">
                <div style="display:grid; gap:7px;">
                  <span style="font-size:7.5px; letter-spacing:0.34em; text-transform:uppercase; color:{{ heroInkSoft }};">Member since 2021</span>
                  <span style="font-family:'Cormorant Garamond',serif; font-size:clamp(23px,2.9vw,29px); font-weight:400; letter-spacing:0.03em; text-shadow:0 1px 0 rgba(255,255,255,0.45), 0 -1px 0 rgba(0,0,0,0.16);">Amélie Rousseau</span>
                  <span tabindex="0" role="button" aria-label="{{ numberAria }}" onClick="{{ toggleNumber }}" onKeyDown="{{ keyNumber }}" style="font-family:ui-monospace,'SFMono-Regular',Menlo,monospace; font-size:clamp(12px,1.45vw,14.5px); font-weight:500; letter-spacing:0.24em; color:{{ heroInkMid }}; text-shadow:0 1px 0 rgba(255,255,255,0.55), 0 -1px 0 rgba(0,0,0,0.2); cursor:pointer; justify-self:start; outline:none;" style-focus="outline:1px solid #7C5CD6; outline-offset:4px">{{ cardNumber }}</span>
                </div>
                <div style="display:grid; gap:5px; justify-items:end; padding-right:6px;">
                  <span style="font-size:8px; letter-spacing:0.28em; text-transform:uppercase; color:{{ heroInkSoft }};">Points</span>
                  <span style="font-family:'Cormorant Garamond',serif; font-size:clamp(24px,3vw,31px); line-height:1;">{{ points }}</span>
                  <div style="width:clamp(58px,7vw,76px); height:2px; background:{{ heroInkFaint }}; border-radius:999px; overflow:hidden;">
                    <div style="height:100%; width:{{ pctInTier }}; background:{{ heroInkMid }};"></div>
                  </div>
                  <span style="font-size:8px; letter-spacing:0.18em; color:{{ heroInkSoft }};">{{ heroMeterLabel }}</span>
                </div>
              </div>
            </div>
          </div>

          <div style="position:absolute; inset:0; backface-visibility:hidden; transform:rotateY(180deg) translateZ(1.5px); border-radius:20px; overflow:hidden; background:{{ heroBackBg }}; box-shadow:0 18px 34px -22px rgba(40,30,60,0.45), inset 0 0 0 1px rgba(255,255,255,0.5); color:{{ heroBackInk }}; display:flex; flex-direction:column;">
            <div style="height:13%; margin-top:4%; background:{{ heroStripe }}; position:relative; overflow:hidden;"><div style="position:absolute; inset:0; background:linear-gradient(180deg,rgba(255,255,255,0.24),rgba(255,255,255,0) 36%,rgba(255,255,255,0.07) 60%,rgba(0,0,0,0.28));"></div></div>
            <div style="padding:clamp(10px,1.4vw,14px) clamp(20px,2.8vw,28px) 0; display:flex; gap:14px; align-items:center;">
              <div style="flex:1; height:clamp(22px,2.6vw,26px); border-radius:3px; background:{{ heroSig }}; box-shadow:inset 0 0 0 1px rgba(120,110,90,0.18); display:flex; align-items:center; padding:0 10px; font-family:'Cormorant Garamond',serif; font-size:14px; font-style:italic; color:{{ heroSigInk }};">Amélie Rousseau</div>
              <span style="font-family:ui-monospace,monospace; font-size:11px; letter-spacing:0.14em; color:{{ heroBackInkSoft }};">CVC 4482</span>
            </div>
            <div style="padding:clamp(8px,1.2vw,12px) clamp(20px,2.8vw,28px); display:flex; gap:16px; align-items:flex-start; justify-content:space-between;">
              <div style="display:grid; gap:6px; align-content:start;">
                <span style="font-size:8.5px; letter-spacing:0.32em; text-transform:uppercase; color:{{ heroBackInkSoft }};">{{ heroTier }} benefits</span>
                <div style="display:grid; gap:4px; font-size:12px; font-weight:300; line-height:1.4;">
                  <sc-for list="{{ heroBenefits }}" as="b" hint-placeholder-count="4">
                    <span>{{ b }}</span>
                  </sc-for>
                </div>
              </div>
              <div style="flex:none; padding:4px; background:{{ heroQrBg }}; border-radius:4px; box-shadow:0 0 0 1px rgba(80,70,60,0.14);">
                <div style="position:relative; width:clamp(46px,5.4vw,56px); aspect-ratio:1; background:{{ heroQr }};">
                  <span style="position:absolute; left:4%; top:4%; width:30%; height:30%; border:2.5px solid {{ heroQrInk }}; background:{{ heroQrBg }};"></span>
                  <span style="position:absolute; right:4%; top:4%; width:30%; height:30%; border:2.5px solid {{ heroQrInk }}; background:{{ heroQrBg }};"></span>
                  <span style="position:absolute; left:4%; bottom:4%; width:30%; height:30%; border:2.5px solid {{ heroQrInk }}; background:{{ heroQrBg }};"></span>
                </div>
              </div>
            </div>
            <div style="margin-top:auto; padding:0 clamp(20px,2.8vw,28px) clamp(12px,1.6vw,16px);">
              <span style="font-size:8.5px; letter-spacing:0.1em; color:{{ heroBackInkSoft }}; font-weight:300; line-height:1.4;">{{ heroFooter }}</span>
            </div>
          </div>
        </div>
      </div>

      <div style="display:grid; gap:22px;">
        <div style="display:grid; gap:8px;">
          <span style="font-size:11px; letter-spacing:0.26em; text-transform:uppercase; color:#9B93A8;">Balance</span>
          <div style="display:flex; align-items:baseline; gap:10px;">
            <span style="font-family:'Cormorant Garamond',serif; font-size:clamp(46px,6vw,64px); line-height:1; font-weight:300;">{{ points }}</span>
            <span style="font-size:13px; letter-spacing:0.16em; text-transform:uppercase; color:#8B8398;">points</span>
          </div>
        </div>
        <div style="display:grid; gap:10px;">
          <div style="height:3px; background:#EBE6F3; border-radius:999px; overflow:hidden;">
            <div style="height:100%; width:{{ pctInTier }}; background:linear-gradient(90deg,#B79BE6,#7C5CD6); border-radius:999px; transition:width 1.2s ease;"></div>
          </div>
          <p style="margin:0; font-size:14px; font-weight:300; color:#6E6879;">{{ progressLine }}</p>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <button onClick="{{ toggleMine }}" style="font-family:'Jost',sans-serif; cursor:pointer; border:1px solid #1C1A22; background:#1C1A22; color:#FAF9FB; padding:13px 26px; border-radius:999px; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; transition:opacity .2s;" style-hover="opacity:0.82">Flip card</button>
          <a href="#rewards" style="border:1px solid #DAD3E6; color:#1C1A22; padding:13px 26px; border-radius:999px; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; transition:border-color .2s;" style-hover="border-color:#B79BE6">Redeem points</a>
        </div>
      </div>
    </section>

    <section style="background:#FFFFFF; border:1px solid #EDE9F3; border-radius:18px; padding:clamp(26px,3.4vw,38px) clamp(22px,3.4vw,44px); margin-bottom:clamp(56px,7vw,96px);">
      <span style="font-size:11px; letter-spacing:0.26em; text-transform:uppercase; color:#9B93A8;">Tier progress</span>
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0; margin-top:30px;">
        <sc-for list="{{ ladder }}" as="step" hint-placeholder-count="4">
          <div style="display:grid; justify-items:center; gap:9px; position:relative;">
            <div style="position:absolute; top:17px; left:calc(50% + 26px); right:calc(-50% + 26px); height:1px; background:{{ step.line }};"></div>
            <div style="width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:12px; z-index:1; background:{{ step.dotBg }}; color:{{ step.dotFg }}; border:1px solid {{ step.dotBorder }};">{{ step.n }}</div>
            <span style="font-size:13px; letter-spacing:0.06em; color:{{ step.labelColor }};">{{ step.name }}</span>
            <span style="font-size:12px; font-weight:300; color:#ADA5BA;">{{ step.threshold }}</span>
          </div>
        </sc-for>
      </div>
    </section>

    <section id="tiers" style="display:grid; gap:clamp(24px,3vw,34px); margin-bottom:clamp(56px,7vw,96px);">
      <div style="display:grid; gap:clamp(13px,1.6vw,18px);">
        <div style="height:2px; background:#1C1A22;"></div>
        <div style="display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:14px;">
          <span style="font-size:9px; letter-spacing:0.4em; text-transform:uppercase; color:#1C1A22;">The Collection</span>
          <span style="font-size:9px; letter-spacing:0.32em; text-transform:uppercase; color:#9A94A6;">Issue 03 · Four plates</span>
        </div>
        <div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:clamp(14px,2.4vw,44px);">
          <h2 style="font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(34px,4.6vw,54px); margin:0; line-height:1.02;">Four levels of care</h2>
          <p style="margin:0; max-width:40ch; font-size:14px; font-weight:300; color:#6E6879; line-height:1.6; text-wrap:pretty;">Tap any card to see what it holds. Points never expire while your membership stays active.</p>
        </div>
      </div>

      <div style="display:grid; gap:0; border-bottom:1px solid rgba(28,26,34,0.16);">

        <article style="display:grid; gap:clamp(15px,1.9vw,22px); padding:clamp(22px,2.7vw,34px) 0 clamp(26px,3.2vw,42px); border-top:1px solid rgba(28,26,34,0.16); animation:nayaRise 0.7s cubic-bezier(0.2,0.8,0.2,1)  both;">
            <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px;">
              <div style="display:flex; align-items:baseline; gap:11px;">
                <span style="font-family:'Cormorant Garamond',serif; font-size:clamp(19px,2.1vw,25px); font-weight:300; line-height:1; color:#1C1A22;">I</span>
                <span style="font-size:8.5px; letter-spacing:0.36em; text-transform:uppercase; color:#9A94A6;">Plate one</span>
              </div>
              <span style="font-size:8.5px; letter-spacing:0.3em; text-transform:uppercase; color:#9A94A6;">NL–01</span>
            </div>
            <div style="display:flex; flex-wrap:wrap; align-items:flex-start; gap:clamp(24px,3.4vw,56px);">
              <div style="flex:1 1 340px; min-width:min(100%,280px); max-width:560px;">
          <div style="position:relative; perspective:1300px; cursor:pointer; opacity:{{ opSilver }}; transition:opacity .4s, transform 0.35s cubic-bezier(0.2,0.8,0.2,1); border-radius:22px; outline:none;" style-hover="transform:translateY(-5px)" style-focus="outline:2px solid #7C5CD6; outline-offset:8px" tabindex="0" role="button" aria-label="Silver tier card — press Enter to flip" onClick="{{ toggleSilver }}" onKeyDown="{{ keySilver }}" onMouseMove="{{ moveSilver }}" onMouseLeave="{{ leaveSilver }}">
