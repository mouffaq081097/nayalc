        <article style="display:grid; gap:clamp(15px,1.9vw,22px); padding:clamp(22px,2.7vw,34px) 0 clamp(26px,3.2vw,42px); border-top:1px solid rgba(28,26,34,0.16); animation:nayaRise 0.7s cubic-bezier(0.2,0.8,0.2,1) 0.24s both;">
