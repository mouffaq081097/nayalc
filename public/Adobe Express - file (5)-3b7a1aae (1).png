        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(28px,3.4vw,38px); margin:0; line-height:1.12;">How points gather</h2>
        <div style="display:grid; gap:0;">
          <sc-for list="{{ earn }}" as="row" hint-placeholder-count="4">
            <div style="display:flex; justify-content:space-between; align-items:baseline; gap:20px; padding:15px 0; border-bottom:1px solid #EDE9F3;">
              <span style="font-size:15px; font-weight:300; color:#3B3746;">{{ row.label }}</span>
              <span style="font-size:13px; letter-spacing:0.1em; color:#7C5CD6; white-space:nowrap;">{{ row.value }}</span>
            </div>
          </sc-for>
        </div>
      </div>
      <div style="display:grid; gap:18px; align-content:start;">
        <h2 style="font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(28px,3.4vw,38px); margin:0; line-height:1.12;">Ready to redeem</h2>
        <div style="display:grid; gap:12px;">
          <sc-for list="{{ rewards }}" as="r" hint-placeholder-count="3">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:16px; background:#FFFFFF; border:1px solid #EDE9F3; border-radius:14px; padding:18px 20px; transition:border-color .25s, transform .25s;" style-hover="border-color:#C4A9F5; transform:translateY(-2px)">
              <div style="display:grid; gap:4px;">
                <span style="font-size:15px; font-weight:400; color:#1C1A22;">{{ r.name }}</span>
                <span style="font-size:12px; font-weight:300; color:#8B8398;">{{ r.note }}</span>
              </div>
              <span style="font-size:12px; letter-spacing:0.14em; text-transform:uppercase; padding:9px 16px; border-radius:999px; background:{{ r.chipBg }}; color:{{ r.chipFg }}; white-space:nowrap;">{{ r.cost }}</span>
            </div>
          </sc-for>
        </div>
      </div>
    </section>

    <section style="background:linear-gradient(120deg,#F3EDFC 0%,#FAF7FE 60%,#F7F3FB 100%); border-radius:20px; padding:clamp(34px,5vw,62px) clamp(24px,4vw,58px); display:grid; gap:14px; justify-items:center; text-align:center;">
      <span style="font-size:11px; letter-spacing:0.28em; text-transform:uppercase; color:#8B7BB0;">Next ritual</span>
      <h2 style="font-family:'Cormorant Garamond',serif; font-weight:300; font-size:clamp(28px,3.8vw,40px); margin:0; max-width:18ch; line-height:1.14;">Book your seasonal skin consultation</h2>
      <p style="margin:0; max-width:46ch; font-size:15px; font-weight:300; color:#665F76; line-height:1.6;">Included from Gold upward. Twenty-five minutes with a Lumière specialist, and a routine adjusted for the season ahead.</p>
      <a href="#book" style="margin-top:10px; background:#1C1A22; color:#FAF9FB; padding:14px 30px; border-radius:999px; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; transition:opacity .2s;" style-hover="opacity:0.85">Reserve a time</a>
    </section>
  </div>
</div>

</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;pointsBalance&quot;:{&quot;editor&quot;:&quot;int&quot;,&quot;default&quot;:1840,&quot;tsType&quot;:&quot;number&quot;,&quot;min&quot;:0,&quot;max&quot;:6000,&quot;step&quot;:10,&quot;section&quot;:&quot;Member&quot;},&quot;hoverTilt&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Card&quot;}}">
const SKINS = {
  Silver: {
    bg: 'linear-gradient(132deg,#FEFEFF 0%,#EFF1F5 26%,#DADDE4 50%,#F9FAFC 64%,#CBCFD9 84%,#EAECF1 100%)',
    texture: 'repeating-linear-gradient(90deg,rgba(255,255,255,0.62) 0 1px,rgba(120,124,138,0.07) 1px 2px,rgba(255,255,255,0.24) 2px 3px,rgba(120,124,138,0.04) 3px 5px), radial-gradient(140% 100% at 12% -12%,rgba(255,255,255,0.62),rgba(255,255,255,0) 58%)',
    watermark: 'radial-gradient(circle at 40% 40%,rgba(255,255,255,0.55),rgba(255,255,255,0) 70%)',
    sheen: 'linear-gradient(112deg,rgba(255,255,255,0) 38%,rgba(255,255,255,0.6) 50%,rgba(255,255,255,0) 62%)',
    edge: 'linear-gradient(180deg,#F3F5F8,#B9BEC9 45%,#FBFCFE 62%,#A9AEBA)',
    chip: 'linear-gradient(135deg,#EDEFF3,#B9BEC9 45%,#FBFCFE 60%,#A9AEBA)',
    holo: 'conic-gradient(from 210deg,#FFFFFF,#DDE3EC,#F4EFFB,#E7ECF4,#FFFFFF)',
    ink: '#33313C', inkMid: 'rgba(51,49,60,0.7)', inkSoft: 'rgba(51,49,60,0.5)', inkFaint: 'rgba(51,49,60,0.18)',
    shadow: 'radial-gradient(ellipse at center,rgba(60,60,80,0.26),rgba(60,60,80,0) 70%)',
    backBg: 'linear-gradient(160deg,#FAFBFC,#EDEFF3)', backInk: '#4A4855', backInkSoft: 'rgba(51,49,60,0.5)',
    stripe: 'linear-gradient(180deg,#4A4B55,#2E2F37)', sig: 'repeating-linear-gradient(90deg,#F8F9FB 0 6px,#EDEFF3 6px 9px)', sigInk: '#5A5866',
    qrBg: '#FFFFFF', qrInk: '#33313C', qr: 'repeating-conic-gradient(#33313C 0% 25%,#FFFFFF 0% 50%) 0 0/25% 25%',
    core: 'linear-gradient(180deg,#E4E7EC,#B9BEC9 45%,#9BA1AE)',
    thru: 'STATUS THRU 03/27',
    benefits: ['5% off every order', '1 point per €1 spent', 'Two deluxe samples per order', 'Birthday treat'],
    footer: 'Silver status · Non-transferable · Scan in store'
  },
  Gold: {
    bg: 'linear-gradient(132deg,#FEFAF0 0%,#F3E2BC 26%,#E0C489 48%,#FBF2DC 62%,#D8B978 82%,#EFDDB4 100%)',
    texture: 'repeating-linear-gradient(118deg,rgba(255,255,255,0.28) 0 1px,rgba(140,110,50,0.05) 1px 6px)',
    watermark: 'repeating-radial-gradient(circle at center,rgba(255,255,255,0.42) 0 1px,rgba(255,255,255,0) 1px 10px)',
    sheen: 'linear-gradient(112deg,rgba(255,255,255,0) 38%,rgba(255,255,255,0.6) 50%,rgba(255,255,255,0) 62%)',
    edge: 'linear-gradient(180deg,#F6E9C2,#C9A85C 45%,#FAF1D8 62%,#B4913F)',
    chip: 'linear-gradient(135deg,#F6E9C2,#C9A85C 42%,#FAF1D8 58%,#B4913F)',
    holo: 'conic-gradient(from 210deg,#F7E9FF,#D8C4F2,#FBEBC8,#E7D2F6,#F7E9FF)',
    ink: '#443413', inkMid: 'rgba(68,52,19,0.72)', inkSoft: 'rgba(68,52,19,0.5)', inkFaint: 'rgba(68,52,19,0.2)',
    shadow: 'radial-gradient(ellipse at center,rgba(96,70,26,0.34),rgba(96,70,26,0) 70%)',
    backBg: 'linear-gradient(160deg,#FCF7EC,#F4EADA)', backInk: '#5C4A2A', backInkSoft: 'rgba(68,52,19,0.5)',
    stripe: 'linear-gradient(180deg,#3A3128,#231D17)', sig: 'repeating-linear-gradient(90deg,#F7F2E6 0 6px,#EFE7D5 6px 9px)', sigInk: '#6B5A34',
    qrBg: '#FFFDF7', qrInk: '#3A3128', qr: 'repeating-conic-gradient(#3A3128 0% 25%,#FFFDF7 0% 50%) 0 0/25% 25%',
    core: 'linear-gradient(180deg,#EBD9A9,#C0A05A 45%,#9C7F3C)',
    thru: 'STATUS THRU 03/27',
    benefits: ['10% off every order, always', '2× points on serums & treatments', 'Complimentary express shipping', 'Seasonal virtual skin consultation'],
    footer: 'Gold status through 31 March 2027 · Non-transferable'
  },
  Platinum: {
    bg: 'linear-gradient(158deg,#0B0912 0%,#1A1528 24%,#2E2547 48%,#141020 64%,#2A2140 84%,#0E0B18 100%)',
    texture: 'repeating-linear-gradient(97deg,rgba(255,255,255,0.06) 0 1px,rgba(0,0,0,0.055) 1px 3px), radial-gradient(120% 90% at 76% 6%,rgba(226,211,255,0.2),rgba(226,211,255,0) 56%)',
    watermark: 'repeating-radial-gradient(circle at center,rgba(226,210,255,0.22) 0 1px,rgba(255,255,255,0) 1px 10px)',
    sheen: 'linear-gradient(112deg,rgba(255,255,255,0) 38%,rgba(232,219,255,0.32) 50%,rgba(255,255,255,0) 62%)',
    edge: 'linear-gradient(180deg,#F6EFFF,#B6A2DD 32%,#FFFFFF 50%,#8574B4 72%,#E6DAFB)',
    chip: 'linear-gradient(135deg,#F4EEFF,#A899CC 44%,#FCFAFF 60%,#8878B0)',
    holo: 'conic-gradient(from 200deg,#F0E4FF,#C4A9F5,#EFD9C6,#D6C2F5,#F0E4FF)',
    ink: '#F2EDF9', inkMid: 'rgba(242,237,249,0.72)', inkSoft: 'rgba(242,237,249,0.5)', inkFaint: 'rgba(242,237,249,0.22)',
    shadow: 'radial-gradient(ellipse at center,rgba(48,32,78,0.34),rgba(48,32,78,0) 70%)',
    backBg: 'linear-gradient(160deg,#1C1729,#0C0916)', backInk: '#D6CFE4', backInkSoft: '#A99BC4',
    stripe: 'linear-gradient(180deg,#0F0C16,#060409)', sig: 'repeating-linear-gradient(90deg,#EDE7F7 0 6px,#E2DAF0 6px 9px)', sigInk: '#4B3F63',
    qrBg: '#F7F4FC', qrInk: '#241E31', qr: 'repeating-conic-gradient(#241E31 0% 25%,#F7F4FC 0% 50%) 0 0/25% 25%',
    core: 'linear-gradient(180deg,#2E2646,#171227 60%,#0E0A18)',
    thru: 'STATUS THRU 03/27',
    benefits: ['15% off every order', '3× points and free returns', 'Private dermal consultation, twice yearly', 'First access to every launch'],
    footer: 'Platinum status · Concierge · circle@nayalumiere.com'
  },
  Diamond: {
    bg: 'linear-gradient(146deg,#05070E 0%,#0B1120 36%,#121A2C 56%,#070A13 76%,#0C1322 100%)',
    texture: 'repeating-linear-gradient(60deg,rgba(214,232,248,0.05) 0 1px,rgba(255,255,255,0) 1px 27px), repeating-linear-gradient(-60deg,rgba(214,232,248,0.05) 0 1px,rgba(255,255,255,0) 1px 27px)',
    watermark: 'radial-gradient(90% 70% at 88% -8%,rgba(198,226,255,0.16),rgba(198,226,255,0) 62%)',
    sheen: 'linear-gradient(112deg,rgba(255,255,255,0) 40%,rgba(238,244,251,0.42) 50%,rgba(255,255,255,0) 60%)',
    edge: 'linear-gradient(180deg,#FFFFFF,#A8BED6 34%,#FFFFFF 52%,#65798F 74%,#EEF5FD)',
    chip: 'linear-gradient(135deg,#F2F8FF,#93A9C2 45%,#FFFFFF 60%,#75899F)',
    holo: 'conic-gradient(from 160deg,#FFFFFF,#C9DCEF,#E4D3F7,#FBE7D6,#FFFFFF)',
    ink: '#EEF4FB', inkMid: 'rgba(238,244,251,0.75)', inkSoft: 'rgba(238,244,251,0.52)', inkFaint: 'rgba(238,244,251,0.24)',
    shadow: 'radial-gradient(ellipse at center,rgba(20,26,40,0.4),rgba(20,26,40,0) 70%)',
    backBg: 'linear-gradient(160deg,#111825,#04070C)', backInk: '#C9D6E4', backInkSoft: '#93A9C2',
    stripe: 'linear-gradient(180deg,#0A0D13,#04060A)', sig: 'repeating-linear-gradient(90deg,#EDF2F8 0 6px,#DFE7F0 6px 9px)', sigInk: '#3B475A',
    qrBg: '#F4F8FC', qrInk: '#151A24', qr: 'repeating-conic-gradient(#151A24 0% 25%,#F4F8FC 0% 50%) 0 0/25% 25%',
    core: 'linear-gradient(180deg,#1E2632,#0D121B 60%,#05080D)',
    thru: 'INVITATION · NO EXPIRY',
    benefits: ['20% off every order', '4× points, free returns, no minimums', 'A dedicated skin concierge', 'Annual dermatologist session'],
    footer: 'Diamond · By invitation · Your concierge is Camille D.'
  }
};

const KEYS = ['mine', 'silver', 'gold', 'platinum', 'diamond'];

function tierIndex(p) { return p >= 5000 ? 3 : p >= 3000 ? 2 : p >= 1500 ? 1 : 0; }

const BANDS = [
  { name: 'Silver', min: 0, max: 1500 },
  { name: 'Gold', min: 1500, max: 3000 },
  { name: 'Platinum', min: 3000, max: 5000 },
  { name: 'Diamond', min: 5000, max: Infinity }
];

class Component extends DCLogic {
  state = {
    flip: { mine: false, silver: false, gold: false, platinum: false, diamond: false },
    tilt: { mine: null, silver: null, gold: null, platinum: null, diamond: null },
    showNumber: false,
    upgrade: null
  };

  // Flip/tilt transforms are written straight to the node instead of flowing
  // through a template hole, so the visible face always matches committed state.
  _els = {};
  _refs = KEYS.reduce((a, k) => {
    a[k] = el => { this._els[k] = el; if (el) el.style.transform = this.card(k).tf; };
    return a;
  }, {});

  applyTf() {
    for (const k of KEYS) {
      const el = this._els[k];
      if (el) el.style.transform = this.card(k).tf;
    }
  }

  // next value hoisted out of the updater — a non-idempotent updater gets
  // double-invoked in dev and cancels itself out.
  toggle(k) {
    const next = !this.state.flip[k];
    this.setState(s => ({ flip: { ...s.flip, [k]: next } }), () => this.applyTf());
  }

  key(k, e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    e.preventDefault();
    this.toggle(k);
  }

  revealNumber(e) {
    if (e) e.stopPropagation();
    const next = !this.state.showNumber;
    this.setState({ showNumber: next });
  }

  componentDidMount() { this.applyTf(); }

  componentDidUpdate(prev) {
    this.applyTf();
    const a = tierIndex(prev.pointsBalance ?? 1840);
    const b = tierIndex(this.props.pointsBalance ?? 1840);
    if (b > a) {
      clearTimeout(this._up);
      this.setState({ upgrade: BANDS[b].name });
      this._up = setTimeout(() => this.setState({ upgrade: null }), 4200);
    }
  }

  move(k, e) {
    if (this.props.hoverTilt === false) return;
    if (this._reduce === undefined) this._reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (this._reduce) return;
    const r = e.currentTarget.getBoundingClientRect();
    const px = (e.clientX - r.left) / r.width;
    const py = (e.clientY - r.top) / r.height;
    const t = { rx: -(py - 0.5) * 9, ry: (px - 0.5) * 13, sh: (px - 0.5) * 70, px, py };
    if (this._raf) cancelAnimationFrame(this._raf);
    this._raf = requestAnimationFrame(() => this.setState(s => ({ tilt: { ...s.tilt, [k]: t } }), () => this.applyTf()));
  }

  leave(k) { this.setState(s => ({ tilt: { ...s.tilt, [k]: null } }), () => this.applyTf()); }

  componentWillUnmount() { if (this._raf) cancelAnimationFrame(this._raf); clearTimeout(this._up); }

  card(k) {
    const t = this.state.tilt[k];
    const rx = t ? t.rx : 0;
    const ry = (t ? t.ry : 0) + (this.state.flip[k] ? 180 : 0);
    return {
      // translateZ keeps the matrix 3D at rest — a 2D matrix flattens the
      // preserve-3d context and backface-visibility stops culling.
      tf: 'translateZ(0.01px) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg)',
      sh: (t ? t.sh.toFixed(1) : 0) + '%',
      sp: t ? (t.px * 100).toFixed(1) + '% ' + (t.py * 100).toFixed(1) + '%' : '50% -12%',
      hr: (t ? (t.px * 150 - 75 + (t.py * 40 - 20)).toFixed(1) : 0) + 'deg'
    };
  }

  renderVals() {
    const pts = this.props.pointsBalance ?? 1840;
    const band = BANDS.find(b => pts >= b.min && pts < b.max) || BANDS[3];
    const idx = BANDS.indexOf(band);
    const top = idx === 3;
    const next = top ? null : BANDS[idx + 1];
    const pct = top ? 100 : Math.round(((pts - band.min) / (band.max - band.min)) * 100);
    const toNext = top ? 0 : band.max - pts;
    const k = SKINS[band.name];

    const gate = (n, min) => {
      const cur = idx + 1;
      if (n === cur) return { chip: 'Your tier', fg: '#FFFFFF', bg: '#7C5CD6', op: 1 };
      if (n < cur) return { chip: 'Unlocked', fg: '#6D4FC4', bg: '#EFE9FB', op: 1 };
      return { chip: (min - pts).toLocaleString('en-US') + ' points away', fg: '#9B93A8', bg: '#F3F1F7', op: 1, lock: true };
    };
    const g = [gate(1, 0), gate(2, 1500), gate(3, 3000), gate(4, 5000)];
    const c = KEYS.map(n => this.card(n));

    return {
      points: pts.toLocaleString('en-US'),
      cardNumber: this.state.showNumber ? '4482 0917 3306' : '•••• •••• 3306',
      numberAria: this.state.showNumber ? 'Card number 4482 0917 3306. Activate to hide.' : 'Card number hidden. Activate to reveal.',
      toggleNumber: e => this.revealNumber(e),
      keyNumber: e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.revealNumber(e); } },
      heroAria: band.name + ' membership card for Amélie Rousseau, ' + pts.toLocaleString('en-US') + ' points. Press Enter to flip.',
      upgraded: !!this.state.upgrade,
      upgradeText: 'Welcome to ' + (this.state.upgrade || ''),
      keyMine: e => this.key('mine', e),
      keySilver: e => this.key('silver', e),
      keyGold: e => this.key('gold', e),
      keyPlatinum: e => this.key('platinum', e),
      keyDiamond: e => this.key('diamond', e),
      pctInTier: pct + '%',
      progressLine: top
        ? 'You are at the highest tier — Diamond, by invitation. Points now go straight to rewards.'
        : toNext.toLocaleString('en-US') + ' points to ' + next.name + ' — about two full-size serums away.',
      heroTier: band.name,
      heroThru: k.thru,
      heroBenefits: k.benefits,
      heroFooter: k.footer,
      heroMeterLabel: top ? 'HIGHEST TIER' : toNext.toLocaleString('en-US') + ' TO ' + next.name.toUpperCase(),
      heroBg: k.bg, heroTexture: k.texture, heroWatermark: k.watermark, heroSheen: k.sheen,
      heroEdge: k.edge, heroChip: k.chip, heroHolo: k.holo, heroShadow: k.shadow, heroCore: k.core,
      heroInk: k.ink, heroInkMid: k.inkMid, heroInkSoft: k.inkSoft, heroInkFaint: k.inkFaint,
      heroBackBg: k.backBg, heroBackInk: k.backInk, heroBackInkSoft: k.backInkSoft,
      heroStripe: k.stripe, heroSig: k.sig, heroSigInk: k.sigInk,
      heroQr: k.qr, heroQrBg: k.qrBg, heroQrInk: k.qrInk,
      refmine: this._refs.mine, refsilver: this._refs.silver, refgold: this._refs.gold,
      refplatinum: this._refs.platinum, refdiamond: this._refs.diamond,
      shMine: c[0].sh, spMine: c[0].sp, hrMine: c[0].hr,
      shSilver: c[1].sh, spSilver: c[1].sp,
      shGold: c[2].sh, spGold: c[2].sp,
      shPlatinum: c[3].sh, spPlatinum: c[3].sp, hrPlatinum: c[3].hr,
      shDiamond: c[4].sh, spDiamond: c[4].sp, hrDiamond: c[4].hr,
      toggleMine: () => this.toggle('mine'),
      toggleSilver: () => this.toggle('silver'),
      toggleGold: () => this.toggle('gold'),
      togglePlatinum: () => this.toggle('platinum'),
      toggleDiamond: () => this.toggle('diamond'),
      moveMine: e => this.move('mine', e),
      moveSilver: e => this.move('silver', e),
      moveGold: e => this.move('gold', e),
      movePlatinum: e => this.move('platinum', e),
      moveDiamond: e => this.move('diamond', e),
      leaveMine: () => this.leave('mine'),
      leaveSilver: () => this.leave('silver'),
      leaveGold: () => this.leave('gold'),
      leavePlatinum: () => this.leave('platinum'),
      leaveDiamond: () => this.leave('diamond'),
      lockSilver: !!g[0].lock, lockGold: !!g[1].lock, lockPlatinum: !!g[2].lock, lockDiamond: !!g[3].lock,
      chipSilver: g[0].chip, chipFgSilver: g[0].fg, chipBgSilver: g[0].bg, opSilver: g[0].op,
      chipGold: g[1].chip, chipFgGold: g[1].fg, chipBgGold: g[1].bg, opGold: g[1].op,
      chipPlatinum: g[2].chip, chipFgPlatinum: g[2].fg, chipBgPlatinum: g[2].bg, opPlatinum: g[2].op,
      chipDiamond: g[3].chip, chipFgDiamond: g[3].fg, chipBgDiamond: g[3].bg, opDiamond: g[3].op,
      ladder: BANDS.map((b, i) => {
        const n = i + 1, cur = idx + 1, done = n <= cur;
        return {
          n, name: b.name,
          threshold: b.min.toLocaleString('en-US') + '+',
          dotBg: n === cur ? '#7C5CD6' : '#FFFFFF',
          dotFg: n === cur ? '#FFFFFF' : done ? '#7C5CD6' : '#B6AEC4',
          dotBorder: n === cur ? '#7C5CD6' : done ? '#C4A9F5' : '#E6E1EF',
          labelColor: n === cur ? '#7C5CD6' : '#6E6879',
          line: done && n < cur ? '#C4A9F5' : '#EAE6F1'
        };
      }),
      earn: [
        { label: 'Every €1 spent', value: '1 point' },
        { label: 'Serums & treatments', value: '2× points' },
        { label: 'Written a review', value: '75 points' },
        { label: 'Refill instead of repurchase', value: '120 points' },
        { label: 'A friend joins the Circle', value: '250 points' }
      ],
      rewards: [
        { name: 'Deluxe renewal serum, 10ml', note: 'Travel size', cost: '400 pts', chipBg: '#EFE9FB', chipFg: '#6D4FC4' },
        { name: '€25 toward any order', note: 'No minimum', cost: '750 pts', chipBg: '#EFE9FB', chipFg: '#6D4FC4' },
        { name: 'Full-size night cream, 50ml', note: 'The anti-ageing classic', cost: '1,600 pts', chipBg: '#F3F1F7', chipFg: '#9B93A8' },
        { name: 'In-clinic facial, 60 minutes', note: 'Selected partner spas', cost: '3,200 pts', chipBg: '#F3F1F7', chipFg: '#9B93A8' }
      ]
    };
  }
}
</script>
</body>
</html>
