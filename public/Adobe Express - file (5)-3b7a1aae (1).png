                <span style="flex:none; white-space:nowrap; font-size:8.5px; letter-spacing:0.24em; text-transform:uppercase; color:#9A94A6;">Discount</span>
                <span style="flex:1; height:0; border-bottom:1px dotted rgba(28,26,34,0.26); transform:translateY(-3px);"></span>
