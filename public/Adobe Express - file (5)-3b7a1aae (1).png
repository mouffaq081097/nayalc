                  <div style="position:absolute; inset:0; z-index:3; backdrop-filter:blur(3px); background:linear-gradient(150deg,rgba(250,249,251,0.6),rgba(236,231,246,0.45)); display:flex; align-items:flex-end; justify-content:center; padding-bottom:12%;">
                    <span style="font-size:9.5px; letter-spacing:0.24em; text-transform:uppercase; color:#4A4458; background:rgba(255,255,255,0.82); padding:8px 15px; border-radius:999px; box-shadow:0 4px 12px -6px rgba(40,30,60,0.4);">{{ chipDiamond }}</span>
