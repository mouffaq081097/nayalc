          <div style="position:relative; perspective:1300px; cursor:pointer; opacity:{{ opDiamond }}; transition:opacity .4s, transform 0.35s cubic-bezier(0.2,0.8,0.2,1); border-radius:22px; outline:none;" style-hover="transform:translateY(-5px)" style-focus="outline:2px solid #7C5CD6; outline-offset:8px" tabindex="0" role="button" aria-label="Diamond tier card — press Enter to flip" onClick="{{ toggleDiamond }}" onKeyDown="{{ keyDiamond }}" onMouseMove="{{ moveDiamond }}" onMouseLeave="{{ leaveDiamond }}">
            <div style="position:absolute; left:9%; right:9%; bottom:-3%; height:15%; border-radius:50%; background:radial-gradient(ellipse at center,rgba(20,26,40,0.4),rgba(20,26,40,0) 70%); filter:blur(11px);"></div>
            <div style="position:relative; width:100%; aspect-ratio:1.586; transform-style:preserve-3d; transition:transform 0.5s cubic-bezier(0.2,0.8,0.2,1); transform:translateZ(0.01px)" ref="{{ refdiamond }}">
              <div style="position:absolute; inset:0; backface-visibility:hidden; transform:translateZ(1.5px); border-radius:18px; overflow:hidden; background:linear-gradient(146deg,#05070E 0%,#0B1120 36%,#121A2C 56%,#070A13 76%,#0C1322 100%); box-shadow:0 0 0 1px rgba(110,130,156,0.42), 0 1px 2px rgba(6,10,18,0.45), 0 28px 52px -24px rgba(12,18,32,0.78), inset 0 1px 0 rgba(238,244,251,0.42), inset 0 -1px 0 rgba(0,0,0,0.4), inset 0 0 0 1px rgba(214,232,248,0.28); color:#EEF4FB;">
