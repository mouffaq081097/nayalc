                <div style="position:absolute; inset:-20% -40%; background:linear-gradient(108deg,rgba(255,255,255,0) 40%,rgba(238,244,251,0.4) 50%,rgba(255,255,255,0) 60%); transform:translateX({{ shDiamond }}); transition:transform 0.4s ease-out;"></div>
                <div style="position:absolute; right:0; top:0; bottom:0; width:6px; background:linear-gradient(180deg,#FFFFFF,#A8BED6 34%,#FFFFFF 52%,#65798F 74%,#EEF5FD); box-shadow:inset 1px 0 0 rgba(255,255,255,0.5);"></div>
                <div style="position:absolute; right:-12%; bottom:-24%; width:52%; aspect-ratio:405/352; opacity:0.15; -webkit-mask:url(uploads/lotus-mask.png) center/contain no-repeat; mask:url(uploads/lotus-mask.png) center/contain no-repeat; background:currentColor; pointer-events:none;"></div>

                <div style="position:absolute; inset:0; background:linear-gradient(200deg,rgba(255,255,255,0.16) 0 16%,rgba(255,255,255,0) 17% 62%,rgba(255,255,255,0.08) 100%);"></div>
                <div style="position:absolute; inset:0; background:radial-gradient(13% 20% at {{ spDiamond }},rgba(255,255,255,0.6),rgba(255,255,255,0) 70%), radial-gradient(46% 66% at {{ spDiamond }},rgba(255,255,255,0.34),rgba(255,255,255,0) 74%); transition:background 0.25s ease-out;"></div>
