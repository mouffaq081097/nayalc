                  <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:clamp(34px,3.8vw,42px); aspect-ratio:1.32; border-radius:5px; background:linear-gradient(135deg,#F2F8FF,#93A9C2 45%,#FFFFFF 60%,#75899F); box-shadow:inset 0 0 0 1px rgba(255,255,255,0.5); display:grid; grid-template-columns:1fr 1fr; grid-template-rows:repeat(3,1fr);">
                      <div style="border-right:1px solid rgba(20,28,44,0.4); border-bottom:1px solid rgba(20,28,44,0.4);"></div>
                      <div style="border-bottom:1px solid rgba(20,28,44,0.4);"></div>
                      <div style="border-right:1px solid rgba(20,28,44,0.4); border-bottom:1px solid rgba(20,28,44,0.4);"></div>
